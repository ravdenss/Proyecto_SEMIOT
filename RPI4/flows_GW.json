        "name": "make_normality_index",
        "func": "let msg2 = msg;\n//msg2.payload = msg.payload[0]._value;\nlet dif = 0;\nlet tot = 0;\nfor (let i = 0; i < 24; i++) {\n  dif = msg.payload[i]._value - msg.payload[i+24]._value;\n  tot += dif/24;\n}\nmsg2.payload = 1-tot;\nreturn msg2;",
